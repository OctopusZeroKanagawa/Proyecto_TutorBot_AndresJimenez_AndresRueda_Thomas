    {
      "parameters": {
        "jsCode": "const VENTANA_HORAS = 24;\n\nconst tutorias = $('Leer Tutorias').all().map(i => i.json);\nconst estudiantes = $('Leer Estudiantes').all().map(i => i.json);\nconst tutores = $input.all().map(i => i.json);\n\nconst estudiantePorId = {};\nestudiantes.forEach(e => { estudiantePorId[e.id_estudiante] = e; });\nconst tutorPorId = {};\ntutores.forEach(t => { tutorPorId[t.id_tutor] = t; });\n\nconst ahora = new Date();\nconst activos = ['Asignada', 'Confirmada'];\n\nconst recordatorios = [];\ntutorias.forEach(t => {\n  if (!activos.includes(t.estado)) return;\n  if ((t.recordatorio_enviado || '').trim().toLowerCase() === 'si') return;\n  if (!t.fecha || !t.hora) return;\n\n  const momentoTutoria = new Date(`${t.fecha}T${t.hora}:00`);\n  if (isNaN(momentoTutoria.getTime())) return;\n\n  const diffHoras = (momentoTutoria - ahora) / (1000 * 60 * 60);\n  if (diffHoras <= 0 || diffHoras > VENTANA_HORAS) return;\n\n  const estudiante = estudiantePorId[t.id_estudiante] || {};\n  const tutor = tutorPorId[t.id_tutor] || {};\n\n  recordatorios.push({\n    id_tutoria: t.id_tutoria,\n    materia: t.materia,\n    fecha: t.fecha,\n    hora: t.hora,\n    chat_id_estudiante: estudiante.telegram_user || '',\n    nombre_estudiante: estudiante.nombre || '',\n    correo_estudiante: estudiante.correo || '',\n    chat_id_tutor: tutor.telegram_user || '',\n    nombre_tutor: tutor.nombre || ''\n  });\n});\n\nreturn recordatorios.map(r => ({ json: r }));"
      },
